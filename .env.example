# Copy this file to .env and fill in your values. Never commit .env.

# Foundry project endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Name of your model deployment
FOUNDRY_MODEL=gpt-5-mini

# Content Understanding (Azure portal > your Foundry resource > Keys and Endpoint)
CONTENTUNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/
CONTENTUNDERSTANDING_KEY=<key>
